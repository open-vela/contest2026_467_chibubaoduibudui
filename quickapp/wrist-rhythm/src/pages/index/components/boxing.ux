<import name="action-button" src="./action-button.ux"></import>
<template>
  <div class="page boxing-page boxing-page-{{ screenSize }} boxing-page-{{ screenViewport }}">
    <div class="boxing-topline"><text class="boxing-session">节奏拳</text><text class="boxing-remaining">{{ boxingRemainingText }}</text></div>
    <div class="boxing-stats boxing-stats-{{ screenViewport }}">
      <div class="boxing-stat"><text class="boxing-stat-label">得分</text><text class="boxing-stat-value">{{ boxingScoreText }}</text></div>
      <div class="boxing-stat"><text class="boxing-stat-label">连击</text><text class="boxing-stat-value boxing-streak-value {{ boxingComboClass }}">{{ boxingStreakText }}</text></div>
    </div>
    <div class="fighter-slot fighter-slot-{{ screenSize }} fighter-slot-{{ screenViewport }}"></div>
    <div class="fighter-center-layer" style="height: {{ screenCanvasHeight }}px;">
      <div class="fighter-stage fighter-stage-{{ screenSize }} fighter-stage-{{ screenViewport }} {{ boxingTargetClass }}">
        <div class="impact-layer"><div class="impact-wave impact-wave-{{ screenSize }} impact-wave-{{ screenViewport }} impact-wave-one {{ motionClass === 'motion-reduced' ? 'still-wave' : boxingTargetClass + '-wave' }}"></div></div>
        <div class="impact-layer"><div class="impact-wave impact-wave-{{ screenSize }} impact-wave-{{ screenViewport }} impact-wave-two {{ motionClass === 'motion-reduced' ? 'still-wave' : boxingTargetClass + '-wave' }}"></div></div>
        <div class="impact-layer"><div class="impact-wave impact-wave-{{ screenSize }} impact-wave-{{ screenViewport }} impact-wave-three {{ motionClass === 'motion-reduced' ? 'still-wave' : boxingTargetClass + '-wave' }}"></div></div>
        <div class="impact-layer"><div class="impact-wave impact-wave-{{ screenSize }} impact-wave-{{ screenViewport }} impact-wave-four {{ motionClass === 'motion-reduced' ? 'still-wave' : boxingTargetClass + '-wave' }}"></div></div>
        <div class="impact-layer"><div class="impact-wave impact-wave-{{ screenSize }} impact-wave-{{ screenViewport }} impact-wave-five {{ motionClass === 'motion-reduced' ? 'still-wave' : boxingTargetClass + '-wave' }}"></div></div>
        <div class="fighter-anchor fighter-anchor-{{ screenSize }} fighter-anchor-{{ screenViewport }}">
          <image class="fighter fighter-{{ screenSize }} fighter-{{ screenViewport }} {{ boxingTargetClass }}-fighter" src="{{ fighterFrameSrc }}" object-fit="contain"></image>
        </div>
      </div>
    </div>
    <text class="boxing-prompt boxing-prompt-{{ screenSize }} boxing-prompt-{{ screenViewport }}">{{ boxingPrompt }}</text>
    <text class="boxing-pace">{{ boxingPaceLabel }}</text>
    <text class="boxing-message">{{ boxingMessage }}</text>
    <div class="stop-button stop-button-{{ screenViewport }} boxing-stop boxing-stop-{{ screenViewport }}"><action-button label="结束并返回首页" motion-class="{{ motionClass }}" onactivate="stopBoxing"></action-button></div>
  </div>
</template>
<script>
export default {
  onReady() { console.log('WRIST_VIEW ' + JSON.stringify({ view: 'boxing', timestamp: Date.now(), remaining: this.boxingRemainingText, score: this.boxingScoreText, streak: this.boxingStreakText })); },
  props: {
    screenCanvasHeight: { type: Number, default: 480 },
    motionClass: { type: String, default: 'motion-full' },
    screenSize: { type: String, default: 'regular' },
    screenViewport: { type: String, default: 'normal' },
    boxingRemainingText: { type: String, default: '30' },
    boxingScoreText: { type: String, default: '0' },
    boxingStreakText: { type: String, default: '0' },
    boxingComboClass: { type: String, default: 'combo-calm' },
    boxingPrompt: { type: String, default: '准备' },
    boxingPaceLabel: { type: String, default: '' },
    boxingTargetClass: { type: String, default: 'target-waiting' },
    fighterFrameSrc: { type: String, default: '/common/training-8a8ab3423b8f/guard-00.png' },
    boxingMessage: { type: String, default: '' },
  },
  stopBoxing() { this.$emit('stopBoxing'); },
};
</script>
<style lang="scss">
@use '../../../common/prism' as p;
.page { @include p.page; }
.boxing-page { position: relative; padding-top: 26px; background-color: p.$canvas; }
.boxing-topline { width: 240px; flex-direction: column; justify-content: center; align-items: center; }
.boxing-session { font-size: 22px; font-weight: 700; color: p.$text; }
.boxing-remaining { margin-top: 1px; font-size: 20px; font-weight: 700; color: p.$text; }
.boxing-stats { width: 246px; height: 44px; margin-top: 4px; flex-direction: row; justify-content: space-around; }
.boxing-stat { width: 120px; flex-direction: column; align-items: center; }
.boxing-stat-label { font-size: 11px; color: p.$muted; }
.boxing-stat-value { font-size: 23px; font-weight: 700; color: p.$text; }
.combo-calm { color: p.$violet; }
.combo-hot { color: p.$amber; }
.fighter-slot { width: 210px; height: 210px; margin-top: 5px; }
.fighter-center-layer { position: absolute; left: 0; top: 0; width: 480px; height: 480px; justify-content: center; align-items: center; }
.fighter-stage { position: relative; width: 210px; height: 210px; margin-top: 0; border-width: 1px; border-color: p.$line; border-radius: 105px; justify-content: center; align-items: center; background-color: p.$surface; }
.impact-layer { position: absolute; left: 0; top: 0; width: 100%; height: 100%; justify-content: center; align-items: center; }
/* Fixed geometry prevents mirror-origin drift. Pulses wait for arm extension. */
.impact-wave { width: 32px; height: 32px; border-width: 2px; border-color: p.$violet; border-radius: 100px; opacity: 0; animation-delay: 120ms; }
.impact-wave-two { width: 70px; height: 70px; animation-delay: 175ms; }
.impact-wave-three { width: 112px; height: 112px; animation-delay: 230ms; }
.impact-wave-four { width: 160px; height: 160px; animation-delay: 285ms; }
.impact-wave-five { width: 200px; height: 200px; animation-delay: 340ms; }
.impact-wave-five.impact-wave-compact { width: 184px; height: 184px; }
.target-hit-wave { animation-name: impact-expand; animation-duration: 180ms; animation-timing-function: ease-out; animation-iteration-count: 1; }
.target-active-wave { border-color: p.$amber; animation-name: beat-expand; animation-duration: 180ms; animation-timing-function: ease-out; animation-iteration-count: 1; }
.fighter-anchor { width: 210px; height: 180px; justify-content: center; align-items: center; }
.fighter { width: 210px; height: 180px; }
.target-missed-fighter { opacity: 0.62; }
@keyframes impact-expand { 0% { opacity: 0.8; } 100% { opacity: 0; } }
@keyframes beat-expand { 0% { opacity: 0.5; } 100% { opacity: 0; } }
.boxing-prompt { margin-top: 6px; font-size: 24px; font-weight: 700; color: p.$text; }
.boxing-pace { margin-top: 1px; font-size: 14px; color: p.$muted; }
.boxing-message { height: 18px; font-size: 13px; color: p.$violet; }
.stop-button { @include p.action-slot; margin-top: 14px; }
.boxing-stop { height: p.$touch-height; margin-top: 4px; }
.boxing-page-compact { padding-top: 20px; }
.fighter-stage-compact { width: 190px; height: 190px; border-radius: 95px; }
.fighter-slot-compact { width: 190px; height: 190px; }
.fighter-anchor-compact { width: 190px; height: 163px; }
.fighter-compact { width: 190px; height: 163px; }
.boxing-page-short { padding-top: 8px; }
.boxing-stats-short { height: 38px; margin-top: 1px; }
.fighter-stage-short { width: 110px; height: 110px; margin-top: 0; border-radius: 55px; }
.fighter-slot-short { width: 110px; height: 110px; margin-top: 1px; }
.fighter-anchor-short { width: 110px; height: 94px; }
.fighter-short { width: 110px; height: 94px; }
.impact-wave-short { width: 14px; height: 14px; }
.impact-wave-two.impact-wave-short { width: 30px; height: 30px; }
.impact-wave-three.impact-wave-short { width: 50px; height: 50px; }
.impact-wave-four.impact-wave-short { width: 78px; height: 78px; }
.impact-wave-five.impact-wave-short { width: 104px; height: 104px; }
.boxing-prompt-short { margin-top: 1px; font-size: 22px; }
.stop-button-short { height: p.$touch-height; margin-top: 4px; }
.boxing-stop-short { height: p.$touch-height; margin-top: 1px; }
.boxing-prompt-compact { margin-top: 8px; }
@include p.still('.still-wave');
</style>
