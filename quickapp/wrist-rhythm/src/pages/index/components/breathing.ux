<import name="action-button" src="./action-button.ux"></import>
<template>
  <div class="page breathing-page breathing-page-{{ screenSize }} breathing-page-{{ screenViewport }}">
    <text class="session-label">稳态训练</text>
    <text class="remaining">{{ remainingText }}</text>
    <div class="orb-shell orb-shell-{{ screenSize }} orb-shell-{{ screenViewport }}">
      <image class="breath-art breath-art-{{ screenSize }} breath-art-{{ screenViewport }}" src="{{ breathFrameSrc }}" object-fit="contain"></image>
    </div>
    <text class="phase-label phase-label-{{ screenViewport }}">{{ phaseLabel }}</text>
    <text class="pattern-label">{{ patternLabel }}</text>
    <text class="pattern-reason">{{ patternReason }}</text>
    <div class="stop-button stop-button-{{ screenViewport }}"><action-button label="结束训练" motion-class="{{ motionClass }}" onactivate="stopTraining"></action-button></div>
  </div>
</template>
<script>
export default {
  onReady() { console.log('WRIST_VIEW ' + JSON.stringify({ view: 'breathing', timestamp: Date.now(), remaining: this.remainingText, phase: this.phaseLabel })); },
  props: {
    motionClass: { type: String, default: 'motion-full' },
    screenSize: { type: String, default: 'regular' },
    screenViewport: { type: String, default: 'normal' },
    remainingText: { type: String, default: '60' },
    breathPhase: { type: String, default: 'inhale' },
    breathRhythmClass: { type: String, default: 'rhythm-standard' },
    breathFrameSrc: { type: String, default: '/common/training-8a8ab3423b8f/breath-00.png' },
    phaseLabel: { type: String, default: '慢慢吸气' },
    patternLabel: { type: String, default: '标准节奏 · 4-2-4' },
    patternReason: { type: String, default: '数据不足，使用默认节奏' },
  },
  stopTraining() { this.$emit('stopTraining'); },
};
</script>
