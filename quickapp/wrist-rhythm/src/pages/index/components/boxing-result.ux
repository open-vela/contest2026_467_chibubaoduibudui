<import name="action-button" src="./action-button.ux"></import>
<template>
  <div class="page boxing-result-page boxing-result-page-{{ screenSize }} boxing-result-page-{{ screenViewport }}">
    <text class="boxing-result-kicker">RHYTHM / COMPLETE</text>
    <div class="completion-stage completion-stage-{{ screenViewport }}">
      <div class="completion-halo completion-halo-{{ screenViewport }} {{ motionClass === 'motion-reduced' ? 'still-completion' : '' }}"></div>
      <text class="boxing-result-score boxing-result-score-{{ screenViewport }}">{{ boxingResultScore }}</text>
    </div>
    <text class="boxing-result-score-label">本局得分</text>

    <div class="boxing-result-grid boxing-result-grid-{{ screenViewport }}">
      <div class="boxing-result-cell boxing-result-cell-{{ screenViewport }}">
        <text class="boxing-result-value">{{ boxingResultHits }}</text>
        <text class="boxing-result-label">命中 / 目标</text>
      </div>
      <div class="boxing-result-cell boxing-result-cell-{{ screenViewport }}">
        <text class="boxing-result-value coral">{{ boxingResultStreak }}</text>
        <text class="boxing-result-label">最高连击</text>
      </div>
    </div>

    <div class="boxing-hr-result boxing-hr-result-{{ screenViewport }}">
      <text class="boxing-hr-label">心率</text>
      <text class="boxing-hr-value">{{ boxingResultHeartRate }}</text>
    </div>
    <div class="boxing-hr-result boxing-hr-result-{{ screenViewport }}">
      <text class="boxing-hr-label">压力</text>
      <text class="boxing-hr-value">{{ boxingResultStress }}</text>
    </div>
    <div class="primary-button result-button result-button-{{ screenViewport }}">
      <action-button label="完成" kind="primary" tone="violet" motion-class="{{ motionClass }}" onactivate="returnHome"></action-button>
    </div>
  </div>
</template>

<script>
export default {
  onReady() { console.log('WRIST_VIEW ' + JSON.stringify({ view: 'boxingResult', timestamp: Date.now(), score: this.boxingResultScore, hits: this.boxingResultHits, maxStreak: this.boxingResultStreak })); },
  props: {
    motionClass: { type: String, default: 'motion-full' },
    screenSize: { type: String, default: 'regular' },
    screenViewport: { type: String, default: 'normal' },
    boxingResultScore: { type: String, default: '0' },
    boxingResultHits: { type: String, default: '0 / 0' },
    boxingResultStreak: { type: String, default: '0' },
    boxingResultHeartRate: { type: String, default: '训练期间未取得数据' },
    boxingResultStress: { type: String, default: '训练期间未取得数据' },
  },
  returnHome() { this.$emit('returnHome'); },
};
</script>

