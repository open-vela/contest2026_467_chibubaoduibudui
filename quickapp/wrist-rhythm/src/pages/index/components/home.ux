        <div class="dial-index index-7"></div>
        <div class="dial-index index-8"></div>
        <div class="dial-index index-9"></div>
        <div class="dial-index index-10"></div>
        <div class="dial-index index-11"></div>
      </div>
      <div class="orbit-pulse orbit-pulse-{{ screenViewport === 'short' ? 'short' : screenSize }} {{ motionClass === 'motion-reduced' ? 'still-pulse' : vitalPulseClass }}"></div>
      <div class="orbit-ring orbit-ring-{{ screenViewport === 'short' ? 'short' : screenSize }}">
        <text class="status-dot {{ suggest ? 'status-dot-alert' : '' }}">●</text>
        <text class="status-title status-title-{{ screenViewport }}">{{ statusTitle }}</text>
        <text class="status-subtitle status-subtitle-{{ screenViewport }}">{{ statusSubtitle }}</text>
        <div class="metrics metrics-{{ screenSize }} metrics-{{ screenViewport }}">
          <div class="metric metric-{{ screenViewport }}">
            <text class="metric-value {{ heartRateText === '待更新' || heartRateText === '不支持' || heartRateText === '不可用' ? 'metric-status' : '' }} metric-value-{{ screenViewport }}">{{ heartRateText }}</text>
            <text class="metric-label">心率 bpm</text>
          </div>
          <div class="metric-divider"></div>
          <div class="metric metric-{{ screenViewport }}">
            <text class="metric-value {{ stressText === '待更新' || stressText === '不支持' || stressText === '不可用' ? 'metric-status' : '' }} metric-value-{{ screenViewport }}">{{ stressText }}</text>
            <text class="metric-label">压力分</text>
          </div>
        </div>
      </div>
    </div>

    <text class="health-message health-message-{{ screenViewport }}">{{ healthMessage }}</text>
    <div class="mode-buttons mode-buttons-{{ screenSize }} mode-buttons-{{ screenViewport }}">
      <div class="mode-button mode-button-{{ screenSize }} mode-button-{{ screenViewport }} steady-mode">
        <action-button label="稳态 60" detail="01 / 放松" tone="ice" kind="mode" motion-class="{{ motionClass }}" onactivate="startTraining"></action-button>
      </div>
      <div class="mode-button mode-button-{{ screenSize }} mode-button-{{ screenViewport }} boxing-mode">
        <action-button label="节奏拳" detail="02 / 活力" tone="violet" kind="mode" motion-class="{{ motionClass }}" onactivate="startBoxing"></action-button>
      </div>
    </div>
    <text class="disclaimer disclaimer-{{ screenViewport }}">训练体验仅供参考，不作为医疗建议</text>
  </div>
</template>

<script>
export default {
  onReady() { console.log('WRIST_VIEW ' + JSON.stringify({ view: 'home', timestamp: Date.now(), heartRate: this.heartRateText, stress: this.stressText })); },
  props: {
    motionClass: { type: String, default: 'motion-full' },
    screenSize: { type: String, default: 'regular' },
    screenViewport: { type: String, default: 'normal' },
    suggest: { type: Boolean, default: false },
    vitalPulseClass: { type: String, default: 'pulse-a' },
    statusTitle: { type: String, default: '' },
    statusSubtitle: { type: String, default: '' },
    heartRateText: { type: String, default: '--' },
    stressText: { type: String, default: '--' },
    healthMessage: { type: String, default: '' },
  },
  startTraining() { this.$emit('startTraining'); },
  startBoxing() { this.$emit('startBoxing'); },
};
</script>

