{
  "package": "com.openvela.wristrhythm",
  "name": "wrist-rhythm",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1000,
  "icon": "/common/app-icon-512.png",
  "deviceTypeList": [
    "watch"
  ],
  "features": [
    { "name": "service.health" },
    { "name": "system.sensor" },
    { "name": "system.device" },
    { "name": "system.storage" }
  ],
  "permissions": [
    { "name": "hapjs.permission.HEALTH" }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": 480
  },
  "router": {
    "entry": "pages/index",
    "pages": {
      "pages/index": {
        "component": "index"
      }
    }
  }
}
