<import name="action-button" src="./action-button.ux"></import>
<template>
  <div class="page result-page result-page-{{ screenSize }} result-page-{{ screenViewport }}">
    <text class="result-kicker">SESSION / COMPLETE</text>
    <div class="completion-stage completion-stage-{{ screenViewport }}">
      <div class="completion-halo completion-halo-{{ screenViewport }} {{ motionClass === 'motion-reduced' ? 'still-completion' : '' }}"></div>
      <div class="result-icon result-icon-{{ screenViewport }}"><text class="result-check result-check-{{ screenViewport }}">✓</text></div>
    </div>
    <text class="result-title result-title-{{ screenViewport }}">完成一次稳态</text>
    <text class="result-subtitle">单次数值变化不代表训练效果</text>

    <div class="result-row result-row-{{ screenViewport }}">
      <div class="result-name-wrap">
        <text class="result-name">心率</text>
        <text class="result-detail">{{ resultHeartRateDetail }}</text>
      </div>
      <text class="result-delta {{ heartRateImproved ? 'delta-good' : 'delta-neutral' }}">{{ resultHeartRateDelta }}</text>
    </div>
    <div class="result-row result-row-{{ screenViewport }}">
      <div class="result-name-wrap">
        <text class="result-name">压力</text>
        <text class="result-detail">{{ resultStressDetail }}</text>
      </div>
      <text class="result-delta {{ stressImproved ? 'delta-good' : 'delta-neutral' }}">{{ resultStressDelta }}</text>
    </div>

    <div class="primary-button result-button result-button-{{ screenViewport }}">
      <action-button label="完成" kind="primary" tone="ice" motion-class="{{ motionClass }}" onactivate="returnHome"></action-button>
    </div>
  </div>
</template>

<script>
export default {
  onReady() { console.log('WRIST_VIEW ' + JSON.stringify({ view: 'result', timestamp: Date.now(), heartRate: this.resultHeartRateDelta, stress: this.resultStressDelta })); },
  props: {
    motionClass: { type: String, default: 'motion-full' },
    screenSize: { type: String, default: 'regular' },
    screenViewport: { type: String, default: 'normal' },
    resultHeartRateDetail: { type: String, default: '' },
    resultHeartRateDelta: { type: String, default: '' },
    resultStressDetail: { type: String, default: '' },
    resultStressDelta: { type: String, default: '' },
    heartRateImproved: { type: Boolean, default: false },
    stressImproved: { type: Boolean, default: false },
  },
  returnHome() { this.$emit('returnHome'); },
};
</script>

