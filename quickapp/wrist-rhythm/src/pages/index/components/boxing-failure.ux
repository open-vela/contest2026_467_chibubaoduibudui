<template>
  <div class="page failure-page failure-page-{{ screenSize }} failure-page-{{ screenViewport }}">
    <text class="failure-kicker">节奏拳 · 未完成</text>
    <text class="failure-title">训练已中断</text>
    <text class="failure-reason">{{ boxingFailureReason }}</text>
    <text class="failure-note">本局不生成完成成绩</text>
    <div class="failure-button" onclick="retryBoxing"><text class="retry-label">重试</text></div>
    <div class="failure-back" onclick="returnHome"><text class="back-label">返回首页</text></div>
  </div>
</template>
<script>
export default {
  onReady() { console.log('WRIST_VIEW ' + JSON.stringify({ view: 'boxingFailure', timestamp: Date.now() })); },
  props: {
    screenSize: { type: String, default: 'regular' },
    screenViewport: { type: String, default: 'normal' },
    boxingFailureReason: { type: String, default: '' },
  },
  retryBoxing() { this.$emit('retryBoxing'); },
  returnHome() { this.$emit('returnHome'); },
};
</script>
