<import name="action-button" src="./action-button.ux"></import>
<template>
  <div class="page home-page home-page-{{ screenSize }} home-page-{{ screenViewport }}">
    <div class="brand-row">
      <div class="brand-lockup"><text class="brand">腕上节律</text><text class="eyebrow">RHYTHM / NOW</text></div>
    </div>

    <div class="vital-orbit vital-orbit-{{ screenViewport === 'short' ? 'short' : screenSize }} {{ suggest ? 'orbit-alert' : 'orbit-steady' }}">
      <div class="dial-indices dial-indices-{{ screenViewport === 'short' ? 'short' : screenSize }}">
        <div class="dial-index index-0"></div>
        <div class="dial-index index-1"></div>
        <div class="dial-index index-2"></div>
        <div class="dial-index index-3"></div>
        <div class="dial-index index-4"></div>
